# ─────────────────────────────────────────────────────────────
# BMAD — Configurações pessoais (não versionadas)
# Cada colaboradora mantém sua própria config.yaml localmente.
# Use os arquivos config.template.yaml como ponto de partida.
# ─────────────────────────────────────────────────────────────
_bmad/bmm/config.yaml
_bmad/core/config.yaml
_bmad/_memory/config.yaml

# Memória de sessão pessoal dos agentes BMAD
_bmad/_memory/storyteller-sidecar/stories-told.md
_bmad/_memory/storyteller-sidecar/story-preferences.md

# Sessões locais do Copilot
.copilot/

# ─────────────────────────────────────────────────────────────
# Dados — nunca commitar datasets (arquivos grandes)
# Cada pesquisadora mantém os dados localmente.
# Veja as instruções de download no README do ml-pipeline.
# ─────────────────────────────────────────────────────────────
data/
ml-pipeline/data/
# Exceção: src/data/ é código-fonte, não dados — deve ser versionado
!ml-pipeline/src/data/
!ml-pipeline/src/data/**
!ml-pipeline/data/
!ml-pipeline/data/raw/
!ml-pipeline/data/raw/.gitkeep
!ml-pipeline/data/processed/
!ml-pipeline/data/processed/.gitkeep
!ml-pipeline/data/schema/
!ml-pipeline/data/schema/.gitkeep
*.csv
*.pcap
*.parquet

# Modelos treinados (podem ser grandes — compartilhar via Drive/release)
*.pkl
*.joblib
*.keras
*.h5
*.pt
*.pth
ml-pipeline/models/
!ml-pipeline/models/
!ml-pipeline/models/.gitkeep
!ml-pipeline/models/model_rf_temporal_v2.pkl
!ml-pipeline/models/model_rf_temporal_v2.pkl.sha256

# Artefatos experimentais locais (volumosos)
ml-pipeline/reports_local/

# Evidências textuais do protocolo temporal; binários intermediários continuam locais
ml-pipeline/reports_temporal/*
!ml-pipeline/reports_temporal/.gitkeep
!ml-pipeline/reports_temporal/unsw/
!ml-pipeline/reports_temporal/unsw/**/
!ml-pipeline/reports_temporal/unsw/**/*.json
!ml-pipeline/reports_temporal/unsw/**/*.json.sha256
!ml-pipeline/reports_temporal/unsw/**/*.csv
!ml-pipeline/reports_temporal/unsw/**/*.csv.sha256
!ml-pipeline/reports_temporal/unsw/**/*.md
!ml-pipeline/reports_temporal/unsw/**/*.md.sha256
# Ambientes virtuais Python
.venv/
ml-pipeline/.venv-tf/
venv/
env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Dependências Node.js
node_modules/
dashboard/node_modules/

# Build do dashboard
dist/
dashboard/dist/

# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/settings.json
*.swp
*.swo

# Segredos locais
.env
*.env
ml-pipeline/.env
dashboard/.env

# Documentos pessoais do relatório final; somente o plano histórico é versionado
docs/emili/relatorio-final/*
!docs/emili/relatorio-final/plano-previsao-antecipada.md
