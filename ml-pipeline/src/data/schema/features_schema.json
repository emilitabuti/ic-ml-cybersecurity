{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrato de entrada do pipeline temporal UNSW-NB15",
  "version": "2.0.0",
  "dataset": "UNSW-NB15",
  "task": "detecção binária contextual no fim de janelas temporais",
  "target": {
    "column": "Binary_Label",
    "values": {
      "0": "BENIGN",
      "1": "Attack"
    }
  },
  "temporal_order": {
    "start_column": "Stime",
    "end_column": "Ltime",
    "tie_breaker": "source_order",
    "shuffle": false,
    "window_size": 10
  },
  "raw_feature_names": [
    "sport",
    "dsport",
    "dur",
    "sbytes",
    "dbytes",
    "sttl",
    "dttl",
    "sloss",
    "dloss",
    "Sload",
    "Dload",
    "Spkts",
    "Dpkts",
    "swin",
    "dwin",
    "stcpb",
    "dtcpb",
    "smeansz",
    "dmeansz",
    "trans_depth",
    "res_bdy_len",
    "Sjit",
    "Djit",
    "Sintpkt",
    "Dintpkt",
    "tcprtt",
    "synack",
    "ackdat",
    "is_sm_ips_ports",
    "ct_state_ttl",
    "ct_flw_http_mthd",
    "is_ftp_login",
    "ct_ftp_cmd",
    "ct_srv_src",
    "ct_srv_dst",
    "ct_dst_ltm",
    "ct_src_ltm",
    "ct_src_dport_ltm",
    "ct_dst_sport_ltm",
    "ct_dst_src_ltm",
    "proto",
    "state",
    "service"
  ],
  "categorical_features": ["proto", "state", "service"],
  "preprocessing_policy": {
    "fit_scope": "treino de cada fold ou treino final",
    "numeric": "mediana seguida de RobustScaler",
    "categorical": "moda seguida de OneHotEncoder(handle_unknown='ignore')",
    "refit_on_validation_or_test": false
  },
  "feature_selection_policy": {
    "method": "importância de Random Forest",
    "fit_scope": "somente treino do fold",
    "selected_count": 30,
    "persisted_in_serving_artifact": true
  },
  "split_policy": {
    "method": "cronológico com folds expansivos",
    "development_folds": 3,
    "purge_records": 9,
    "test_is_closed_until_final_evaluation": true
  }
}
