# Variáveis de ambiente do ML Pipeline
# Copie este arquivo para .env e ajuste os valores conforme necessário.

# Seed global para reprodutibilidade científica (fixo em config.py como RANDOM_SEED)
PYTHONHASHSEED=42

# Tamanho da janela deslizante (sliding window)
WINDOW_SIZE=10

# Proporção do conjunto de teste no split train/test (0.0 < TEST_SIZE < 1.0)
TEST_SIZE=0.2

# Threshold mínimo de confiança para exibir alertas
CONFIDENCE_THRESHOLD=0.8

# Caminho para os modelos serializados
MODEL_PATH=models/

# Rastreamento e treino científico
MLFLOW_TRACKING_URI=mlruns
TRAINING_REPORTS_DIR=reports
K_FOLDS=5

# Hiperparâmetros dos modelos do Epic 3
RF_N_ESTIMATORS=100
RF_MAX_DEPTH=
DT_MAX_DEPTH=
MLP_HIDDEN_LAYER_SIZES=64,32
MLP_MAX_ITER=200
LSTM_EPOCHS=10
LSTM_BATCH_SIZE=256
