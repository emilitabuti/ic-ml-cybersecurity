# Pipeline temporal canônico
PYTHONHASHSEED=42
MODEL_ARTIFACT_PATH=models/model_rf_temporal_v2.pkl
CONFIDENCE_THRESHOLD=0.8

# Integração com dashboard
DASHBOARD_AUTOLOAD_REAL_EVENTS=false
DASHBOARD_AUTOLOAD_EVENTS_FILE=reports/isabela/syn_flood/dashboard_history_events.json
