# Variáveis de ambiente do ML Pipeline
# Copie este arquivo para .env e ajuste os valores conforme necessário.

# Seed global para reprodutibilidade científica (fixo em config.py como RANDOM_SEED)
PYTHONHASHSEED=42

# Tamanho da janela deslizante (sliding window)
WINDOW_SIZE=10

# Proporção do conjunto de teste no split train/test (0.0 < TEST_SIZE < 1.0)
TEST_SIZE=0.2

# Threshold mínimo de confiança para exibir alertas
CONFIDENCE_THRESHOLD=0.8

# Email notification for critical demo alerts
# For Gmail, use an app password, not the normal account password.
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=analista@example.com
ALERT_EMAIL_FROM=dashboard@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=dashboard@example.com
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Caminho para os modelos serializados
MODEL_PATH=models/
# Carregamento inicial do historico do dashboard ao iniciar a API
DASHBOARD_AUTOLOAD_REAL_EVENTS=false
DASHBOARD_AUTOLOAD_EVENTS_FILE=reports/isabela/syn_flood/dashboard_history_events.json
DASHBOARD_AUTOLOAD_LIMIT=20


# Rastreamento e treino científico
MLFLOW_TRACKING_URI=mlruns
TRAINING_REPORTS_DIR=reports
K_FOLDS=5

# Hiperparâmetros dos modelos do Epic 3
RF_N_ESTIMATORS=100
RF_MAX_DEPTH=
DT_MAX_DEPTH=
MLP_HIDDEN_LAYER_SIZES=64,32
MLP_MAX_ITER=200
LSTM_EPOCHS=10
LSTM_BATCH_SIZE=256
