# Variáveis de ambiente do ML Pipeline
# Copie este arquivo para .env e ajuste os valores conforme necessário.

# Tamanho da janela deslizante (sliding window)
WINDOW_SIZE=10

# Threshold mínimo de confiança para exibir alertas
CONFIDENCE_THRESHOLD=0.5

# Caminho para os modelos serializados
MODEL_PATH=models/
